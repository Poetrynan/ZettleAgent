{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZettelAgent",
  "version": "0.3.0",
  "identifier": "com.zettelagent.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:prod",
    "frontendDist": "../dist"
  },
  "plugins": {},
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZettelAgent",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: https://api.github.com https://huggingface.co https://*.huggingface.co https://*.hf.co",
        "worker-src": "'self' blob:",
        "frame-src": "https: http: blob:",
        "object-src": "blob:",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ws://localhost:1420 http://localhost:1420 ipc: http://ipc.localhost asset: http://asset.localhost blob: data: https://api.github.com https://huggingface.co https://*.huggingface.co https://*.hf.co",
        "worker-src": "'self' blob:",
        "frame-src": "https: http: blob:",
        "object-src": "blob:",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/ocr_models/*": "ocr_models/",
      "resources/demo-vault/*.md": "demo-vault/"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/64x64.png",
      "icons/32x32.png"
    ],
    "windows": {
      "wix": {
        "language": {
          "en-US": {
            "localePath": "locales/en-US.wxl"
          },
          "zh-CN": {
            "localePath": "locales/zh-CN.wxl"
          }
        }
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
